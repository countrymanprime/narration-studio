{
  "roots": [
    ".claude",
    ".editorconfig",
    ".gitattributes",
    ".github",
    ".gitignore",
    ".husky",
    ".lychee.toml",
    ".lycheeignore",
    ".markdownlint-cli2.jsonc",
    ".prettierignore",
    ".prettierrc.json",
    ".vscode",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "commitlint.config.cjs",
    "config",
    "docs",
    "knip.jsonc",
    "lint-staged.config.mjs",
    "nx.json",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "project.json",
    "pyproject.toml",
    "scripts",
    "src",
    "stylua.toml",
    "tests",
    "tools",
    "uv.lock"
  ],
  "enforceRetired": true,
  "historical": [
    "docs/adr/",
    "docs/research/mockups/",
    "pnpm-lock.yaml",
    "scripts/ci/layout.json",
    "scripts/ci/layout.test.mjs",
    "scripts/dev/move-studio.mjs"
  ],
  "patterns": [
    "(?<![A-Za-z0-9_.-])shared[\\/]",
    "(?<![A-Za-z0-9_.\\\\-])shell\\\\(?!open)",
    "(?:-C|--dir|working-directory:|directory:)\\s+/?shell(?![A-Za-z0-9_./-])",
    "['\"]shared['\"]",
    "[,(]\\s*['\"]shell['\"]\\s*[,)]",
    "['\"]tools['\"]\\s*,\\s*['\"](?:manuscript-|transcript-)",
    "(?<![A-Za-z0-9_.-])(?<!^\\s*)(?<!studio\\\\?[\\\\/])(?<!\\.\\.[\\\\/])(?:sidecars|integrations)\\\\?[\\\\/]",
    "(?<![A-Za-z0-9_.-])(?<!^\\s*)(?<!studio\\\\?[\\\\/])libs\\\\?[\\\\/]python",
    "(?<![A-Za-z0-9_.-])(?<!^\\s*)(?<!studio\\\\?[\\\\/])(?<!\\.\\.[\\\\/])tests\\\\?[\\\\/]audacity3",
    "['\"]apps['\"]\\s*[,/]\\s*['\"](?:ui|desktop|site)['\"]"
  ],
  "renames": [
    { "from": "apps/desktop", "to": "src/studio/desktop" },
    { "from": "apps/site", "to": "src/web" },
    { "from": "apps/ui", "to": "src/studio/ui" },
    { "from": "tools/manuscript-guide/daws/audacity", "to": "src/studio/integrations/audacity/manuscript-guide" },
    { "from": "tools/transcript-compare/daws/audacity", "to": "src/studio/integrations/audacity/transcript-compare" },
    { "from": "tools/manuscript-guide/core/tests", "to": "src/studio/sidecars/manuscript-guide/tests" },
    { "from": "tools/manuscript-teleprompter/core/tests", "to": "src/studio/sidecars/manuscript-teleprompter/tests" },
    { "from": "tools/transcript-compare/core/tests", "to": "src/studio/sidecars/transcript-compare/tests" },
    { "from": "tools/manuscript-guide", "to": "src/studio/sidecars/manuscript-guide" },
    { "from": "tools/manuscript-teleprompter", "to": "src/studio/sidecars/manuscript-teleprompter" },
    { "from": "tools/transcript-compare", "to": "src/studio/sidecars/transcript-compare" },
    { "from": "shared/audacity", "to": "src/studio/integrations/audacity" },
    { "from": "shared/config", "to": "config" },
    { "from": "shared/python", "to": "src/studio/libs/python" },
    { "from": "shared/reaper", "to": "src/studio/integrations/reaper" },
    { "from": "shared/test-fixtures", "to": "tests/fixtures" },
    { "from": "shared/ui", "to": "src/studio/ui" },
    { "from": "shell/", "to": "src/studio/desktop/" }
  ]
}
