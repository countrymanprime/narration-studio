{
  "_comment": "Code paths and the docs a change to them owes (scripts/ci/docs-impact.mjs). A rule is satisfied when the change touches any one doc in `docs` (a glob is allowed). `exclude` removes tests and fixtures from `paths`. Keep the map in step with .claude/skills/doc-impact-check/references/map.md.",
  "rules": [
    {
      "id": "reaper-lua",
      "paths": ["integrations/reaper/*.lua"],
      "exclude": [],
      "docs": [
        "docs/architecture/reaper-bridge.md",
        "docs/architecture/reaper-navigation.md",
        "docs/architecture/daw-integration.md",
        "docs/operations/reaper-verification-pass.md"
      ]
    },
    {
      "id": "daw-port",
      "paths": ["apps/desktop/internal/dawport/*.go", "apps/desktop/internal/dawport/reaper/*.go", "apps/desktop/internal/dawport/audacity/*.go"],
      "exclude": ["**/*_test.go"],
      "docs": ["docs/reference/daw/capabilities.md", "docs/reference/daw/matrix.md", "docs/architecture/daw-integration.md"]
    },
    {
      "id": "reaper-bridge-host",
      "paths": ["apps/desktop/internal/bridge/*.go"],
      "exclude": ["**/*_test.go"],
      "docs": ["docs/architecture/reaper-bridge.md", "docs/architecture/reaper-navigation.md", "docs/architecture/wire-contracts.md"]
    },
    {
      "id": "ui-primitives",
      "paths": ["apps/ui/src/components/primitives/*.tsx", "apps/ui/src/styles.css"],
      "exclude": ["**/*.test.tsx", "**/*.stories.tsx"],
      "docs": ["docs/ui/**", "docs/design/*.md"]
    },
    {
      "id": "manuscript-guide",
      "paths": ["sidecars/manuscript-guide/core/**", "apps/desktop/internal/guide/*.go"],
      "exclude": ["**/*_test.go", "**/tests/**"],
      "docs": [
        "docs/utilities/manuscript-guide.md",
        "docs/architecture/story-bible-preview.md",
        "docs/architecture/story-bible-entity-accuracy.md",
        "docs/guides/using-the-app/story-bible.md"
      ]
    },
    {
      "id": "transcript-compare",
      "paths": ["sidecars/transcript-compare/core/**"],
      "exclude": ["**/tests/**"],
      "docs": ["docs/utilities/transcript-compare.md", "docs/utilities/recording-coverage.md", "docs/utilities/take-review.md"]
    },
    {
      "id": "teleprompter",
      "paths": ["sidecars/manuscript-teleprompter/core/**"],
      "exclude": ["**/tests/**"],
      "docs": ["docs/architecture/manuscript-teleprompter.md", "docs/guides/using-the-app/booth.md"]
    },
    {
      "id": "findings",
      "paths": ["apps/desktop/internal/findings/*.go"],
      "exclude": ["**/*_test.go"],
      "docs": ["docs/architecture/findings-contract.md"]
    },
    {
      "id": "downloads",
      "paths": ["apps/desktop/internal/assets/*.go", "config/*-assets.json"],
      "exclude": ["**/*_test.go"],
      "docs": ["docs/architecture/first-use-dependency-provisioning.md", "docs/architecture/model-provenance.md"]
    },
    {
      "id": "in-app-update",
      "paths": ["apps/desktop/internal/update/*.go"],
      "exclude": ["**/*_test.go"],
      "docs": ["docs/architecture/in-app-update.md", "docs/operations/ci-and-releases.md"]
    },
    {
      "id": "data-files",
      "paths": [
        "apps/desktop/internal/persist/*.go",
        "apps/desktop/internal/bookmarks/bookmarks.go",
        "apps/desktop/internal/chaptersync/store.go",
        "apps/desktop/internal/character/character.go",
        "apps/desktop/internal/character/readonly.go",
        "apps/desktop/internal/coverage/results.go",
        "apps/desktop/internal/credits/templates.go",
        "apps/desktop/internal/deliveryprofile/store.go",
        "apps/desktop/internal/editlog/accepted.go",
        "apps/desktop/internal/editlog/editlog.go",
        "apps/desktop/internal/evidence/cache.go",
        "apps/desktop/internal/evidence/ledger.go",
        "apps/desktop/internal/evidence/mapping.go",
        "apps/desktop/internal/extraction/store/store.go",
        "apps/desktop/internal/findings/store.go",
        "apps/desktop/internal/gapreview/gapreview.go",
        "apps/desktop/internal/guide/readonly.go",
        "apps/desktop/internal/guide/service.go",
        "apps/desktop/internal/manuscript/reader.go",
        "apps/desktop/internal/marks/marks.go",
        "apps/desktop/internal/passagemap/passagemap.go",
        "apps/desktop/internal/pickuplist/store.go",
        "apps/desktop/internal/prepmarkup/prepmarkup.go",
        "apps/desktop/internal/preview/store.go",
        "apps/desktop/internal/production/production.go",
        "apps/desktop/internal/project/manifest.go",
        "apps/desktop/internal/recents/store.go",
        "apps/desktop/internal/scriptprep/scriptprep.go",
        "apps/desktop/internal/series/series.go",
        "apps/desktop/internal/settings/store.go",
        "apps/desktop/internal/stages/store.go",
        "apps/desktop/internal/transcript/service.go",
        "apps/desktop/internal/update/check.go"
      ],
      "exclude": ["**/*_test.go"],
      "docs": ["docs/reference/data-files.md"]
    },
    {
      "id": "trust-boundary",
      "paths": [
        "apps/desktop/internal/process/*.go",
        "apps/desktop/internal/bridge/transport.go",
        "integrations/reaper/narration_bridge_core.lua",
        "apps/desktop/internal/audacitybridge/transport.go",
        "apps/desktop/internal/audacitybridge/pipe_*.go",
        "apps/desktop/internal/assets/download.go",
        "apps/desktop/internal/assets/extract.go",
        "apps/desktop/internal/assets/manifest.go",
        "apps/desktop/internal/update/install.go",
        "apps/desktop/internal/update/manifest.go",
        "apps/desktop/internal/update/stage.go",
        "apps/desktop/internal/update/spawn_*.go",
        ".github/workflows/prerelease.yml",
        ".github/workflows/promote-release.yml",
        "apps/desktop/internal/importer/*.go"
      ],
      "exclude": ["**/*_test.go"],
      "docs": ["docs/architecture/threat-model.md", "SECURITY.md"]
    },
    {
      "id": "ci-and-release",
      "paths": [".github/workflows/*.yml", "scripts/release/*.mjs", "scripts/ci/*.mjs", "tools/docs-site/*.py"],
      "exclude": ["**/*.test.mjs"],
      "docs": ["docs/operations/ci-and-releases.md", "docs/operations/verification-tooling.md", "docs/operations/github-workflow.md"]
    }
  ]
}
