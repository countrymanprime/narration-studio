{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "manuscript-guide",
  "projectType": "application",
  "tags": ["toolchain:python"],
  "implicitDependencies": ["narration-common", "config"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node scripts/quality.mjs python -m ruff format --check src/studio/sidecars/manuscript-guide",
          "node scripts/quality.mjs python -m ruff check src/studio/sidecars/manuscript-guide",
          "node scripts/ci/doc-comments.mjs python src/studio/sidecars/manuscript-guide"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/ci/coverage-gate.mjs pytest src/studio/sidecars/manuscript-guide src/studio/sidecars/manuscript-guide/tests"
      }
    }
  }
}
