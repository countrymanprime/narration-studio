{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "narration-utils-site",
  "projectType": "application",
  "tags": ["toolchain:node"],
  "implicitDependencies": ["narration-utils-ui"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir {projectRoot} run lint:ci"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir {projectRoot} run typecheck"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir {projectRoot} run format:check"
      }
    },
    "architecture": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir {projectRoot} run architecture"
      },
      "metadata": {
        "description": "The import rule of apps/site (.dependency-cruiser.mjs): the site takes only the listed shared modules of apps/ui."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir {projectRoot} run test"
      },
      "metadata": {
        "description": "Vitest over apps/site/demo/src: the banner, the window protocol and the simulated DAW."
      }
    },
    "test-node": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test {projectRoot}/build/*.test.mjs"
      },
      "metadata": {
        "description": "node:test suites of the site's build scripts (the docs renderer, the window pages, the self-containment scan)."
      }
    },
    "build-site": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node {projectRoot}/build/build-demo-site.mjs"
      },
      "outputs": ["{workspaceRoot}/dist-site"],
      "metadata": {
        "description": "The public site in dist-site/: landing page, demo, docs and Storybook. Nothing here publishes it. Named build-site, not build, so the pnpm check gate (which runs every project's build) does not build the site."
      }
    },
    "serve-site": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node {projectRoot}/build/serve.mjs dist-site"
      },
      "metadata": {
        "description": "Serves dist-site/ at http://localhost:4180/ (run build-site first)."
      }
    },
    "test-site": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir {projectRoot} run test:site"
      },
      "metadata": {
        "description": "Playwright smoke test of the built site. Builds dist-site/ first and serves it under /site/. Not run by CI."
      }
    }
  },
  "sourceRoot": "apps/site/demo/src"
}
