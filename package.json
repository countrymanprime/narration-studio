{
  "name": "workspace",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.27.0",
  "description": "Release and developer tooling for the app.",
  "scripts": {
    "prepare": "husky",
    "bootstrap": "node scripts/bootstrap.mjs",
    "test:bootstrap": "node --test scripts/bootstrap.test.mjs",
    "assets:seed": "go -C src/studio/desktop run ./cmd/seed-assets",
    "brand:sync": "node scripts/brand/sync.mjs",
    "brand:check": "node scripts/brand/sync.mjs --check",
    "check": "node scripts/quality.mjs check",
    "check:fast": "node scripts/quality.mjs staged",
    "eval:skills": "node scripts/ci/skill-evals.mjs",
    "knip": "knip",
    "site:build": "node src/web/build/build-demo-site.mjs",
    "site:serve": "node src/web/build/serve.mjs dist-site",
    "lint:md": "node scripts/ci/lint-markdown-changed.mjs",
    "lint:md:fix": "node scripts/ci/lint-markdown-changed.mjs --fix",
    "fix:staged": "lint-staged",
    "release:sync": "node scripts/release/sync-version.mjs",
    "release:check": "node scripts/release/sync-version.mjs --check",
    "release:notes": "node scripts/release/generate-notes.mjs",
    "release:package": "node scripts/release/assets.mjs package",
    "release:verify-assets": "node scripts/release/assets.mjs verify",
    "release:verify-installable": "node scripts/release/verify-installable.mjs",
    "release:promote": "node scripts/release/promote.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@nx/js": "^23.3.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "markdown-it": "15.0.3",
    "markdownlint-cli2": "0.23.3",
    "mermaid": "^12.2.0",
    "nx": "^23.3.0"
  }
}
