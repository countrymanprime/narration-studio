.venv/
.runtime/
.bootstrap/
.piper/
__pycache__/
*.pyc
.pytest_cache/
node_modules/
.vite/
src/studio/ui/dist/
src/web/demo/dist/
src/web/test-results/
src/studio/ui/screenshots/
src/studio/ui/playwright-report/
src/studio/ui/test-results/
# A container whose Chromium is older than the pinned Playwright build (mock-match's own MOCK_MATCH_CHROMIUM
# workaround, playwright.mock-match.config.ts) needs the same override for the other suites; kept local, never
# committed, since it names no fixed path any other container would share.
src/studio/ui/playwright*.local.config.ts
src/studio/ui/coverage/
.coverage
.coverage.*
.hypothesis/
*.tsbuildinfo
logs/
# Local Claude Code state stays out; the shared settings (plugin marketplaces for cloud sessions) and the
# project skills, agents and path-scoped rules (so cloud sessions and worktrees get them) are tracked.
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/agents/
!.claude/rules/
src/studio/desktop/cmd/narration-utils/frontend/dist/*
!src/studio/desktop/cmd/narration-utils/frontend/dist/.gitkeep
src/studio/desktop/cmd/narration-utils/frontend/wailsjs/
src/studio/desktop/cmd/narration-utils/resources/config/
src/studio/desktop/cmd/narration-utils/resources/runtime/
src/studio/desktop/cmd/narration-utils/resources/reaper/
src/studio/desktop/build/*
# The Windows icon, version and manifest resource wails-build.mjs embeds and removes after the Go build.
src/studio/desktop/*.syso
!src/studio/desktop/build/appicon.png
!src/studio/desktop/build/windows/
src/studio/desktop/build/windows/*
!src/studio/desktop/build/windows/icon.ico
# The one installer file that differs from Wails' default. scripts/release/wails-build.mjs renders wails_tools.nsh
# and writes the WebView2 bootstrapper beside it on every installer build.
!src/studio/desktop/build/windows/installer/
src/studio/desktop/build/windows/installer/*
!src/studio/desktop/build/windows/installer/project.nsi
.release-build/
.nx/
.test-tmp/
.test-tmp-*/
.tmp-hub-probe/
release-notes.md
target/
!src/studio/ui/src/components/production/target/
.tools/
.cache/
src/studio/ui/storybook-static/
tools/docs-site/build/
.lycheecache
src/studio/ui/playwright.local.config.ts

# The Wails build output (go build in src/studio/desktop names its binary after the directory)
/src/studio/desktop/shell
src/studio/integrations/reaper/narration-utils-app-path.txt
src/studio/integrations/reaper/narration-utils-app-path.txt.tmp
/dist-site/
