{
  "name": "narration-utils-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:site": "node build/build-demo-site.mjs",
    "serve:site": "node build/serve.mjs ../../dist-site",
    "build:app": "vite build --config demo/vite.config.ts --mode site",
    "build:pages-demo": "vite build --config demo/vite.config.ts --mode demo",
    "test": "vitest run",
    "test:site": "playwright test -c playwright.config.ts",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "architecture": "depcruise demo/src --config .dependency-cruiser.mjs",
    "format": "prettier --write \"demo/**/*.{ts,tsx,json}\" \"tests/**/*.ts\" \"*.{json,ts}\"",
    "format:check": "prettier --check \"demo/**/*.{ts,tsx,json}\" \"tests/**/*.ts\" \"*.{json,ts}\""
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
